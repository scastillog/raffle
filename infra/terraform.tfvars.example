# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
aws_region           = "us-east-1"
aws_profile          = "account" # or remove to use the default credentials
project_name         = "rifa"
raffle_name          = "Gran Rifa de 1.000.000"
ticket_price         = 25000
prize                = 1000000
draw_date            = "2026-11-24"
payment_instructions = "Nequi o Daviplata: 300 123 4567 a nombre de Juan Pérez"
whatsapp_number      = "573001234567"
reservation_hours    = 24
admin_password       = "cambia-esta-clave-larga"
purchase_rate_limit  = 2 # purchases/second shared by all buyers; raise if buyers get "muchas solicitudes"
purchase_burst_limit = 5

# Optional custom domain (certificate must be in us-east-1). Point your DNS at the CloudFront domain.
# custom_domain       = "rifa.example.com"
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."
